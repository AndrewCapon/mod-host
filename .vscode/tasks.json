{
  // See https://go.microsoft.com/fwlink/?LinkId=733558
  // for the documentation about the tasks.json format
  "version": "2.0.0",
  "tasks": [
    {
        "label": "make mod-host",
        "type": "shell",
        "command": "make",
        "problemMatcher": ["$gcc"]
    },
    {
        "label": "deploy mod-host",
        "type": "shell",
        "command": "scp mod-host.so root@192.168.51.1:Development",
        "dependsOn" : "make mod-host",
        "problemMatcher": []
    },
    {
        "label": "start gdb server",
        "type": "shell",
        "dependsOn" : "deploy mod-host",
        "isBackground": true,
        "command": "ssh root@192.168.51.1 'cd Development; pwd; ./startDebugServer.sh'",
        "problemMatcher": [
            {
                "pattern": [
                    {
                    "regexp": ".",
                    "file": 1,
                    "location": 2,
                    "message": 3
                    }
                ],
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "Listening on port 4444",
                    "endsPattern": ".",
                }
            }
        ]
    }
]
}
