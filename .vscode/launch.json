{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "(gdb) Dwarf Debug",
            "type": "cppdbg",
            "request": "launch",
            // "preLaunchTask": "start gdb server", 
            "program": "${workspaceFolder}/mod-host.so",
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb-multiarch",
            "cwd": "${workspaceFolder}",
            "targetArchitecture": "arm",
            "logging": {
                "engineLogging": true
            },
            "customLaunchSetupCommands": [
                {
                    "description": "Set sysroot",
                    "text": "set sysroot target:",
                    "ignoreFailures": true
                },
                {
                    "description": "Connect directly to your running remote gdbserver",
                    "text": "target remote 192.168.51.1:4444",
                    "ignoreFailures": false
                }
            ],
            // Prevents VS Code from sending a "run" or "continue" command after connecting
            "launchCompleteCommand": "None" 
        },
        {
            "name": "(gdb) Local debug",
            "preLaunchTask": "make mod-host",
            "type": "cppdbg",
            "request": "launch",
            "program": "/home/andrewcapon/MOD/mod-host/mod-host",
            "args": ["-v", "-n", "-p 5555", "-f 5556"],
            "stopAtEntry": false,
            "cwd": "/home/andrewcapon/MOD/mod-host/",
            "environment": [{"name":"MOD_LOG", "value":"1"}, {"name":"ENABLE_MIDI_NRPN", "value":"0"}],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ],
            "envFile": "${workspaceFolder}/.env"
        }

    ]
}